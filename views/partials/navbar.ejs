<style>
  body {
    margin: 0;
    padding: 0;
    font-family: sans-serif;
  }

  .Navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: linear-gradient(45deg, #54bb90, #408551);
    padding: 0 1rem;
    height: 4.5rem;
  }

  .Navbar .left ul,
  .Navbar .right ul {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .Navbar img {
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 1rem;
  }

  .Navbar .left ul li,
  .Navbar .right ul li {
    margin: 0 0.5rem;
  }

  .Navbar .left ul li a,
  .Navbar .right ul li a {
    text-decoration: none;
    font-size: 1.1rem;
    color: #dbffd8;
    padding: 10px;
    border-radius: 50px;
    transition: background 0.2s;
  }

  .Navbar .left ul li a:hover {
    background: rgba(255,255,255,0.3);
  }

  .Navbar .right ul li a.loginbutton {
    background: white;
    color: #428a57;
    font-weight: bold;
    padding: 10px 20px;
    border-radius: 50px;
    font-size: 1.1rem;
    margin-right: 0.5rem;
  }

  .Navbar .right ul li a.logout {
    color: #dbffd8;
    font-size: 1.1rem;
    padding: 10px;
    border-radius: 50px;
    background: rgba(255,255,255,0.1);
  }

  .hamburg {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    margin-left: 1rem;
  }

  .hamburg div {
    width: 2rem;
    height: 3px;
    background: #fff;
    margin: 3px 0;
    border-radius: 2px;
  }

  #side-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 80vw;
    max-width: 320px;
    height: 100vh;
    background: linear-gradient(45deg, rgb(235, 192, 255), rgb(132, 219, 184));
    box-shadow: 2px 0 10px rgba(0,0,0,0.2);
    z-index: 1000;
    flex-direction: column;
    animation: slideIn 0.3s;
  }

  @keyframes slideIn {
    from { transform: translateX(-100%);}
    to { transform: translateX(0);}
  }

  #side-drawer nav ul {
    flex-direction: column;
    padding: 2rem 1rem;
    margin: 0;
    list-style: none;
    height: auto;
  }

  #side-drawer img {
    height: 3rem;
    border-radius: 50%;
    margin-bottom: 1.5rem;
  }

  #side-drawer li {
    margin-bottom: 1.2rem;
    text-align: left;
  }

  #side-drawer a {
    text-decoration: none;
    font-size: 1.2rem;
    color: #428a57;
    padding: 10px 0;
    display: block;
    border-radius: 30px;
    transition: background 0.2s;
  }

  #side-drawer a:hover {
    background: rgba(255,255,255,0.3);
  }

  #side-drawer .close-btn {
    font-size: 2rem;
    color: #428a57;
    background: none;
    border: none;
    position: absolute;
    top: 1rem;
    right: 1rem;
    cursor: pointer;
  }

  @media (max-width: 780px) {
    .Navbar .left ul,
    .Navbar .right ul {
      display: none;
    }
    .hamburg {
      display: flex;
    }
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const hamburg = document.querySelector(".hamburg");
    const sideDrawer = document.getElementById("side-drawer");
    const closeBtn = document.getElementById("side-drawer-close");

    hamburg.addEventListener("click", function () {
      sideDrawer.style.display = "flex";
    });

    closeBtn.addEventListener("click", function () {
      sideDrawer.style.display = "none";
    });

    // Optional: close drawer when clicking outside
    sideDrawer.addEventListener("click", function (e) {
      if (e.target === sideDrawer) {
        sideDrawer.style.display = "none";
      }
    });
  });
</script>

<nav class="Navbar">
  <div class="left">
    <ul>
      <li>
        <a href="#">
          <img src="https://github.com/Om-dharra/coffee_site.github.io/blob/main/WhatsApp%20Image%202023-12-25%20at%2016.44.47_67604895.jpg?raw=true" alt="Logo" />
        </a>
      </li>
      <li><a href="/home">Home</a></li>
      <li><a href="/FillForm">Carbon emission</a></li>
      <li><a href="/Contact">Contact Us</a></li>
    </ul>
  </div>
  <div class="right">
    <ul>
      <% if(currentUser){ %>
        <li>
          <a class="loginbutton" href="/dashboard"><%= currentUser.username %></a>
        </li>
        <li>
          <a class="logout" href="/logout">LogOut</a>
        </li>
      <% }else{ %>
        <li>
          <a class="loginbutton" href="/login">Login/Signup</a>
        </li>
      <% } %>
    </ul>
  </div>
  <div class="hamburg" aria-label="Open menu" tabindex="0">
    <div></div>
    <div></div>
    <div></div>
  </div>
</nav>
<aside id="side-drawer">
  <button class="close-btn" id="side-drawer-close" aria-label="Close menu">&times;</button>
  <nav>
    <ul>
      <li>
        <a href="/home">
          <img src="https://github.com/Om-dharra/coffee_site.github.io/blob/main/WhatsApp%20Image%202023-12-25%20at%2016.44.47_67604895.jpg?raw=true" alt="Logo" />
        </a>
      </li>
      <li><a href="/FillForm">Calculate your Carbon emission</a></li>
      <li><a href="/Contact">Contact Us</a></li>
      <% if(currentUser){ %>
        <li>
          <a class="loginbutton" href="/dashboard"><%= currentUser.username %></a>
        </li>
        <li>
          <a class="logout" href="/logout">LogOut</a>
        </li>
      <% }else{ %>
        <li>
          <a class="loginbutton" href="/login">Login/Signup</a>
        </li>
      <% } %>
    </ul>
  </nav>
</aside>
